# Telegram
BOT_TOKEN=9101099430:AAEC7tQjpjGTN0IsFeu9Oq4jEcmRICJbVw8
BOT_USERNAME=accmarketabot
SUPPORT_CONTACT=

# Database (Render provides postgresql://...; it is normalized to asyncpg automatically)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketplace
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Keep false in production and run: alembic upgrade head
AUTO_CREATE_TABLES=false

# Security
# Generate with: python -c "from app.crypto import generate_key; print(generate_key())"
CREDENTIAL_ENCRYPTION_KEY=
WEBHOOK_SECRET=

# Runtime
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Polling locally. On Render set USE_WEBHOOK=true.
USE_WEBHOOK=false
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_DROP_PENDING=false

# Optional
# REDIS_URL=redis://localhost:6379/0

# Business rules
PLATFORM_COMMISSION_RATE=5
HOURLY_RELEASE_RATE=5
HOURLY_RELEASE_INTERVAL_SECONDS=3600
CURRENCY=UZS

# Limits
RATE_LIMIT_PER_MINUTE=30
MAX_CREDENTIAL_FIELDS=8
MAX_SCREENSHOTS=8
MIN_PRICE=1
MAX_PRICE=1000000000
PAGE_SIZE=5
PENDING_ORDER_TTL_MINUTES=30
DISPUTE_AUTO_UNRESOLVED_HOURS=72

# Payments. Keep disabled until a real provider is implemented.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=skip
SKIP_PAYMENT_ENABLED=true

# Telegram
# Never commit a real token. Set BOT_TOKEN in the hosting dashboard.
# BOT_TOKEN is supplied per environment (Render dashboard or local .env).
BOT_USERNAME=accmarketabot
SUPPORT_CONTACT=

# Database (Render provides postgresql://...; it is normalized to asyncpg automatically)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketplace
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Keep false in production and run: python -m alembic upgrade head
AUTO_CREATE_TABLES=false

# Security
# Generate with: python -c "from app.crypto import generate_key; print(generate_key())"
CREDENTIAL_ENCRYPTION_KEY=
# Telegram secret_token: only A-Z, a-z, 0-9, "_" and "-" are allowed.
WEBHOOK_SECRET=

# Runtime
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
# Render injects PORT automatically; keep this default for local runs.
PORT=8080

# Polling locally. On Render webhook mode is enabled automatically.
# Only one delivery mode runs at a time: webhook OR polling, never both.
USE_WEBHOOK=false
# Optional when USE_WEBHOOK=true. On Render, RENDER_EXTERNAL_URL is used automatically.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_DROP_PENDING=false
# Local polling refuses to replace an existing webhook (for example Render's).
# Set true only when you intentionally want to switch back to local polling.
POLLING_FORCE=false

# Optional
# REDIS_URL=redis://localhost:6379/0

# Business rules
PLATFORM_COMMISSION_RATE=7
HOURLY_RELEASE_RATE=5
HOURLY_RELEASE_INTERVAL_SECONDS=3600
CURRENCY=UZS

# Limits
RATE_LIMIT_PER_MINUTE=30
MAX_CREDENTIAL_FIELDS=8
MAX_SCREENSHOTS=8
MIN_PRICE=1
MAX_PRICE=1000000000
PAGE_SIZE=5
PENDING_ORDER_TTL_MINUTES=30
DISPUTE_AUTO_UNRESOLVED_HOURS=72

# Payments. Keep disabled until a real provider is implemented.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=skip
SKIP_PAYMENT_ENABLED=true
